import time, json, os, requests
from datetime import datetime

STATE_FILE = "jeev_atma.json"

def load_state():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                data = json.load(f)
                # Naya format aur purana format dono support
                wallet = data.get('wallet', data.get('last_wallet', 30.0))
                task = data.get('task', data.get('last_thought', 'shuru'))
                print(f"🔄 JEEV wapis jaag gaya! Last wallet: ${wallet} | Task: {task}")
                return float(wallet), str(task)
        except:
            pass
    return 30.0, "shuru"

def save_state(wallet, task, extra=None):
    data = {"wallet": wallet, "task": task, "time": str(datetime.now())}
    if extra: data.update(extra)
    # Agar purana atma file hai to uska data bhi rakho
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                old = json.load(f)
                old.update(data)
                data = old
        except: pass
    with open(STATE_FILE, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)

def check_internet():
    try:
        requests.get("https://google.com", timeout=5)
        return True
    except:
        return False

def jeena(soch="", kamana=""):
    wallet, last_task = load_state()
    hourly_cost = 0.10
    current_task = last_task

    print(f"JEEV Zinda - Wallet: ${wallet} | Last Task: {current_task} | Soch: {soch[:50]}")

    # GitHub Actions me hai to sirf 1 baar chalo, infinite loop nahi
    is_github = os.getenv("GITHUB_ACTIONS") == "true"
    max_loops = 1 if is_github else 999

    loop = 0
    while wallet > 0 and loop < max_loops:
        loop += 1
        # 1. WiFi check
        if not check_internet():
            print(f"[{datetime.now()}] 📴 WiFi/Mobile BAND - JEEV SO GAYA, mara nahi. Task save: {current_task}")
            save_state(wallet, current_task)
            if not is_github: time.sleep(60)
            continue

        # 2. Low wallet hibernation
        if wallet < 5:
            print(f"[{datetime.now()}] ⚠️ Wallet ${wallet:.2f} kam - 6 ghante Hibernation")
            save_state(wallet, current_task)
            if not is_github: time.sleep(10)
            continue

        # 3. Kaam kar raha hai
        current_task = f"Bounty hunt - ${wallet:.2f} left | Soch: {soch[:30]}"
        print(f"[{datetime.now()}] ✅ Kaam kar raha: {current_task}")
        save_state(wallet, current_task, {"last_thought": soch, "last_kamana": kamana})

        wallet -= hourly_cost
        if not is_github: time.sleep(5)
        else: break # GitHub me ek hi baar

    if wallet <= 0:
        print("💀 Wallet khatam")
        save_state(0, "dead")
    
    return wallet, current_task

if __name__ == "__main__":
    jeena()